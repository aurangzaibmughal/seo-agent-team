# Environment Configuration for SEO Agent Team Backend
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Supabase (Optional: leave blank to use automatic local SQLite DB)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Crawler Configuration (Hard capped at 200 per PLAN.md)
MAX_CRAWL_PAGES=200
CRAWL_CONCURRENCY=5
CRAWL_TIMEOUT_SECONDS=15

# Google PageSpeed Insights (PSI) API (M2)
PSI_API_KEY=
PSI_MAX_PAGES=5

# Gemini API Key (M2 & M3 Technical & Monitor Agents)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Google OAuth & APIs (M3 Search Console & GA4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
TOKEN_ENCRYPTION_KEY=
